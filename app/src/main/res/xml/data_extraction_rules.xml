<?xml version="1.0" encoding="utf-8"?>
<!-- Respaldo y transferencia (Android 12 o superior): el token de sesión nunca sale del teléfono -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="unihogar_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="unihogar_session.xml" />
    </device-transfer>
</data-extraction-rules>
